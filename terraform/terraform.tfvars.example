# Copy this file to terraform.tfvars and fill in your own values.
primary_region       = "ap-south-1"
dr_region            = "ap-southeast-1"
primary_ip           = "REPLACE_WITH_PRIMARY_PUBLIC_IP"
primary_instance_id  = "REPLACE_WITH_PRIMARY_INSTANCE_ID"
primary_sg_id        = "REPLACE_WITH_PRIMARY_SECURITY_GROUP_ID"

admin_cidr     = "REPLACE_WITH_YOUR_PUBLIC_IP/32"
ssh_public_key = "REPLACE_WITH_YOUR_SSH_PUBLIC_KEY"
instance_type  = "t3.small"

# Optional DNS failover (requires a public Route 53 hosted zone)
# domain_name = "example.com"
# record_name = "app"
