# ---- Application (same on primary and DR host; use alphanumeric secrets) ----
POSTGRES_USER=vegah_user
POSTGRES_PASSWORD=change_me_alnum
POSTGRES_DB=vegah_db
DB_USER=vegah_user
DB_PASSWORD=change_me_alnum
DB_NAME=vegah_db

# ---- Disaster Recovery ----
# Same values on BOTH hosts:
REDIS_PASSWORD=change_me_alnum
REPLICATION_PASSWORD=change_me_alnum
REPL_SLOT=standby_slot
REPL_APP_NAME=standby1

# Primary host:  COMPOSE_FILE=docker-compose.yml:dr/compose.primary.yml
# DR host:       COMPOSE_FILE=docker-compose.yml:dr/compose.standby.yml
COMPOSE_FILE=docker-compose.yml:dr/compose.primary.yml
# DR host only:
PRIMARY_HOST=PRIMARY_PUBLIC_IP
PRIMARY_INSTANCE_ID=i-044897522a44948c4
PRIMARY_AWS_REGION=ap-south-1
BACKUP_BUCKET=
AUTO_FAILOVER=false
WATCHDOG_INTERVAL=10
WATCHDOG_THRESHOLD=6
